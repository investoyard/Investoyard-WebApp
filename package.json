{
  "name": "investoyard",
  "version": "0.1.0",
  "private": true,
  "description": "Investoyard monorepo — IPO information + application platform (India)",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run start:dev --parallel",
    "sync-mobile": "node scripts/sync-mobile.js",
    "sync-mobile:dry": "node scripts/sync-mobile.js --dry-run",
    "sync-mobile:push": "node scripts/sync-mobile.js --commit",
    "postinstall": "node scripts/link-expo-router.js"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "react-native": "0.74.5"
  },
  "engines": {
    "node": ">=18"
  }
}
