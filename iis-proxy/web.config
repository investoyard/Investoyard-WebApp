<?xml version="1.0" encoding="UTF-8"?>
<!--
  Investoyard — IIS reverse proxy to the Next.js production server.
  Point an IIS website's physical path at this folder (D:\Investoyard\iis-proxy).
  Requires: URL Rewrite 2.1 + Application Request Routing (ARR) with "Enable proxy" ticked.
  The Next server must be running on http://localhost:4300 (npm run start in apps/web).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="NextJsReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:4300/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering><requestLimits maxAllowedContentLength="52428800" /></requestFiltering>
    </security>
  </system.webServer>
</configuration>
