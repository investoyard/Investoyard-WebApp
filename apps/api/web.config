<?xml version="1.0" encoding="UTF-8"?>
<!--
  Investoyard API under IIS via iisnode (newipoapi.finwave.co).
  Point the IIS site's physical path at this folder (apps/api). iisnode runs
  dist/main.js and injects PORT as a named pipe; main.ts passes it through.

  Prereqs: install iisnode (https://github.com/Azure/iisnode) + URL Rewrite.
  Env (DATABASE_URL, REDIS_URL, JWT_SECRET, PII_VAULT_KEY, CORS_ORIGIN, …) comes
  from apps/api/.env.

  NOTE THE RELOAD RULE: .env is NOT in watchedFiles below, and iisnode runs with
  cwd = apps/api/dist, so a change to .env is picked up only when the Node worker
  restarts. Touching THIS file is the cheap way to force that — seconds, and no
  app-pool handshake — which is how RAIL_CALLBACK_AUTH was switched on.
-->
<configuration>
  <system.webServer>
    <!-- Remove IIS WebDAV — it intercepts PUT/DELETE and returns 405 before the
         request reaches Node, which breaks REST endpoints (save provider keys /
         chatbot flow via PUT, deletes via DELETE). -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <!-- All requests are handled by the Node app. -->
    <handlers>
      <remove name="WebDAV" />
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Let iisnode serve its own debug UI if ever needed. -->
        <rule name="iisnode-debug" stopProcessing="true">
          <match url="^iisnode" />
          <action type="None" />
        </rule>
        <!-- Everything else → the Node entry point (path is preserved for NestJS). -->
        <rule name="api-to-node">
          <match url="/*" />
          <action type="Rewrite" url="dist/main.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- enableXFF: WITHOUT THIS THE APP NEVER SEES A VISITOR'S IP ADDRESS.
         iisnode talks to Node over a NAMED PIPE, so `req.ip` and
         `req.socket.remoteAddress` describe the pipe, not the caller — and
         investoyard.com is direct-to-origin with no Cloudflare, so there is no
         `cf-connecting-ip` or `x-forwarded-for` to fall back on either. Measured
         2026-10-21: a request carrying a proxy header stored its address
         correctly while an identical one without a header stored an empty
         string. It defaults to FALSE in iisnode's own schema, which is why this
         has to be written down rather than assumed.
         iisnode APPENDS, so behind Cloudflare the header becomes
         "<real client>, <origin hop>" and `clientIp()` taking .split(',')[0]
         still yields the visitor.
         Changing this file recycles the Node process (see watchedFiles), which
         is seconds, not a deploy. -->
    <iisnode
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config;dist\*.js"
      enableXFF="true"
      loggingEnabled="false"
      devErrorsEnabled="false" />

    <!-- Don't let IIS intercept API paths as static files / dirs.
         maxAllowedContentLength: registrar allotment files run to ~120 MB
         (IIS default is 30 MB) — allow 200 MB; multer enforces 126 MB per file.
         NOTE: Cloudflare caps request bodies at 100 MB below Enterprise, so a
         file over that is refused at the edge regardless of these two. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" />
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
