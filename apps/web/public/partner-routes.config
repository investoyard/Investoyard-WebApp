<rewriteMaps>
  <!-- Host -> partner design. EMPTY IN THE BUILD ON PURPOSE: the live copy in apps/web/out is written by
       scripts/partner-routes.js and is never overwritten by a website deploy (publish-web.mjs excludes it).
       web.config reads this file with configSource, so it must always exist; this blank one is the fallback. -->
  <rewriteMap name="PartnerDesign" defaultValue="" />
</rewriteMaps>
