<?xml version="1.0" encoding="UTF-8"?>
<!--
  Investoyard API under IIS via iisnode (newipoapi.finwave.co).
  Point the IIS site's physical path at this folder (apps/api). iisnode runs
  dist/main.js and injects PORT as a named pipe; main.ts passes it through.

  Prereqs: install iisnode (https://github.com/Azure/iisnode) + URL Rewrite.
  Env (DATABASE_URL, REDIS_URL, JWT_SECRET, PII_VAULT_KEY, CORS_ORIGIN, …) is read
  from apps/api/.env by @nestjs/config at startup.
-->
<configuration>
  <system.webServer>
    <!-- All requests are handled by the Node app. -->
    <handlers>
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Let iisnode serve its own debug UI if ever needed. -->
        <rule name="iisnode-debug" stopProcessing="true">
          <match url="^iisnode" />
          <action type="None" />
        </rule>
        <!-- Everything else → the Node entry point (path is preserved for NestJS). -->
        <rule name="api-to-node">
          <match url="/*" />
          <action type="Rewrite" url="dist/main.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config;dist\*.js"
      loggingEnabled="true"
      devErrorsEnabled="false" />

    <!-- Don't let IIS intercept API paths as static files / dirs. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
