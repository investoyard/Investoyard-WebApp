# Investoyard API — copy to .env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/investoyard?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
# Operator (admin console) sessions, shorter than the customer value above.
JWT_EXPIRES_IN_OPERATOR="12h"
PORT=3000

# PII vault (stub: local key). Replace with AWS KMS/Secrets Manager in real envs.
PII_VAULT_KEY="dev-only-32-byte-key-dev-only-32b"

# Rail (NSE e-IPO) — example launch-rail member credential (move to vault/DB in real envs)
NSE_BASE_URL="https://uat.example/eipo"
