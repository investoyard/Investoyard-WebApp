<?xml version="1.0" encoding="UTF-8"?>
<!--
  Investoyard static export — served by IIS from this (out) folder.
  Separate-hosting model: the frontend (investoyard.com) serves only static files;
  the browser calls the Node API on its own origin (newipoapi.finwave.co/api), so no
  reverse-proxy / ARR is needed here. Just correct MIME types + the default document.

  THE SITE MOVED FROM newipo.finwave.co TO investoyard.com ON 2026-10-15, and that
  old host is NOT redirected here — it has been reassigned to FINWAVE as their
  white-label domain. Redirecting it would take a partner's whole site off the air.
  The canonical-host rule below therefore folds only www into the apex.

  (For the single-origin model instead — API behind the SAME site at /api — install
  IIS ARR + URL Rewrite and add a <rewrite> rule forwarding ^api/(.*) to the API; see
  DEPLOY.md §F.)
-->
<configuration>
  <system.webServer>
    <!-- IPOs added AFTER the last static build have no pre-rendered page. Serve the
         client-side fallback (which reads the symbol from the URL and fetches live)
         instead of a 404. Requires the IIS URL Rewrite module (already installed). -->
    <rewrite>
      <rules>
        <!--
          CANONICAL HOST. www.investoyard.com folds into the apex, and plain
          HTTP on the apex is upgraded. Path and query are preserved.

          IT MATCHES BY EXACT HOSTNAME, NEVER "anything that is not the apex",
          and that is the whole safety property. EVERY WHITE-LABEL PARTNER IS
          SERVED BY THIS SAME SITE, off this same web.config — so a catch-all
          redirect here would silently take every partner's domain off the air
          and send their clients to us. A partner host must fall straight
          through to the static files.

          MUST BE THE FIRST RULE. The fallbacks below carry stopProcessing, so a
          request for an unbuilt /ipos/X on www would be rewritten and served
          there — a second indexable copy of every page.

          301, not 302: www has been indexed, and only a permanent redirect
          moves its ranking to the apex. {R:0} is the path with no leading
          slash; IIS appends the query string itself.

          The HTTPS condition is what makes this the HSTS-less upgrade path too —
          a plain-HTTP request to the canonical host lands here and is sent to
          the https form rather than being served in the clear.

          localhost is deliberately NOT matched: this file ships inside out/ and
          gets served by a local IIS during testing, where redirecting to
          production would make the local copy impossible to look at.
        -->
        <rule name="canonical-host" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="^www\.investoyard\.com$" />
            <add input="{HTTP_HOST}:{HTTPS}" pattern="^investoyard\.com:OFF$" />
          </conditions>
          <action type="Redirect" url="https://investoyard.com/{R:0}" redirectType="Permanent" />
        </rule>
        <rule name="ipo-detail-fallback" stopProcessing="true">
          <match url="^ipos/([^/]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="ipos/live/index.html" />
        </rule>
        <rule name="apply-fallback" stopProcessing="true">
          <match url="^apply/([^/]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="apply/live/index.html" />
        </rule>
        <rule name="print-fallback" stopProcessing="true">
          <match url="^print/([^/]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="print/live/index.html" />
        </rule>
        <rule name="news-fallback" stopProcessing="true">
          <match url="^news/([^/]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="news/live/index.html" />
        </rule>
      </rules>
      <!-- HTML must always revalidate — otherwise browsers cache pages across deploys and
           users keep seeing the previous build (hashed _next/* assets stay cacheable). -->
      <outboundRules>
        <rule name="html-no-cache" preCondition="is-html">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, must-revalidate" />
        </rule>
        <preConditions>
          <preCondition name="is-html">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
