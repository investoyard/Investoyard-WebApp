// Investoyard API — Prisma schema (PostgreSQL)
// Implements the Phase 1 Data Model. PII fields hold VAULT TOKEN REFS, not raw values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connects as the non-superuser `investoyard_app` role (RLS-enforced).
  url       = env("DATABASE_URL")
  // Migrations / db push run as postgres (superuser, DDL + bypasses RLS).
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  active
  suspended
  deleted
}

// Relationship values are admin-managed (RelationshipMaster) — stored lowercase.

enum Depository {
  NSDL
  CDSL
}

enum KycStatus {
  unverified
  verified
  failed
}

enum ConsentType {
  service
  marketing
  data_sharing_rail
  analytics
  gmp_disclaimer
}

enum IpoType {
  mainboard
  sme
}

/// What kind of offer this is, as distinct from which board it lists on.
/// Before this existed the four FPOs we hold were identifiable only by the
/// words "Further Public Offer" appearing inside `extra.issueType` — a free-text
/// field that actually holds the pricing method. 48 of the 73 catalogue reports
/// offer an FPO variant, so this one column carries more of them than anything
/// else on the list.
enum Instrument {
  ipo
  fpo
  reit
  invit
}

enum IpoStatus {
  upcoming
  open
  closed
  listed
  withdrawn
}

enum Exchange {
  NSE_EIPO
  BSE_IBBS
}

enum ApplyMethod {
  native
  pdf
}

/// SEBI applicant / reservation category. `individual` is the general public;
/// `shareholder` and `employee` are reserved quotas an issue may (or may not) offer.
enum ApplicantCategory {
  individual
  shareholder
  employee
}

enum ApplicationStatus {
  draft
  submitted
  dp_verified
  dp_failed
  mandate_pending
  upi_blocked
  confirmed
  allotted
  not_allotted
  released
  rejected
  failed
}

enum TenantType {
  platform
  direct
  partner
  branch
}

enum RoleScope {
  own
  subtree
  all
}

enum FeatureValueType {
  boolean
  number
  string
}

/// The tenant tree: platform (operator) → direct / partner → branch.
model Tenant {
  id             String     @id @default(uuid())
  type           TenantType
  parentId       String?
  parent         Tenant?    @relation("TenantTree", fields: [parentId], references: [id])
  children       Tenant[]   @relation("TenantTree")
  slug           String     @unique
  name           String
  status         String     @default("active")
  customDomain   String?    @unique
  brandColor     String?
  goldColor      String?
  logoUrl        String?
  flags          Json?
  profile        Json? // partner/branch empanelment profile (JM+Nuvama fields, doc URLs)
  code           String?    @unique // 6-digit channel code (partners/branches), sequential from 601001
  commissionRate Decimal?   @db.Decimal(5, 2) // % commission on this channel's bids (full tracking)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  roles             Role[]
  memberships       Membership[]
  users             User[]
  investorProfiles  InvestorProfile[]
  consents          Consent[]
  applications      Application[]
  watchlist         WatchlistItem[]
  devices           DeviceToken[]
  memberCredentials MemberCredential[]
  settings          TenantSetting[]
  partnerApiKeys    PartnerApiKey[]

  @@index([parentId])
  @@index([type])
}

/// Admin-managed homepage banner slides — mixed into the auto-generated IPO
/// carousel on the front site (announcements, promos). Operator-global.
model Banner {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String? // full-bleed image slide when set; else a branded text slide
  linkUrl   String?
  ctaLabel  String?
  active    Boolean   @default(true)
  sortOrder Int       @default(100)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// One row per partner-API call, success OR failure — drives the API Call Report.
/// A log table like AuditLog: no FKs, never mutated.
model PartnerApiCall {
  id         String   @id @default(uuid())
  tenantId   String
  keyId      String
  endpoint   String
  ipoSymbol  String?
  applicants Int?
  status     String // ok | error
  httpStatus Int
  error      String?
  durationMs Int?
  at         DateTime @default(now())

  @@index([tenantId, at])
  @@index([at])
}

/// Per-partner API access keys (white-label Print-PDF API). The secret is stored
/// as a sha256 hash and shown ONLY once at creation. Auth: `X-Api-Key: keyId.secret`.
model PartnerApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  keyId      String    @unique // public identifier, e.g. pk_a1b2c3d4e5f6
  secretHash String // sha256(secret)
  label      String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([tenantId])
}

/// Catalog of settable features/flags (platform-global). The defaultValue is the
/// platform-wide baseline; tenants override via TenantSetting, cascading down the tree.
/// Operator-managed provider/integration config (SMS, push, …). Non-secret settings
/// are stored in the clear; secret values are vault-tokenized (field → v2: token),
/// never returned raw. Platform-level (the operator's own accounts) — no tenantId,
/// so it's outside RLS and only reachable via admin RBAC.
model ProviderConfig {
  tenantId  String   @default("t-platform") // 't-platform' = platform default; else a white-label tenant's own config
  provider  String // 'sms' | 'email' | 'push' | 'whatsapp' | 'ai'
  enabled   Boolean  @default(false)
  settings  Json     @default("{}") // non-secret config (providerName, senderId, templateId, …)
  secrets   Json     @default("{}") // field name → vault token
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tenantId, provider])
  @@index([tenantId])
}

// Admin-managed relationship options for applicants. allowMultiple=false ⇒ that
// relation (self, spouse, mother, father) can exist ONCE per account.
model RelationshipMaster {
  id            String   @id @default(uuid())
  name          String   @unique
  allowMultiple Boolean  @default(false)
  sortOrder     Int      @default(100)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

/// News / blog posts — admin-written IPO coverage (the SEO engine). Body is
/// operator-authored rich text/HTML. Published posts are public.
model Post {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  coverUrl    String?
  ipoSymbol   String? // optional link to an IPO's coverage
  tags        String[]  @default([])
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  author      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

/// Anchor-investor master — institutions reusable across IPOs (picked per IPO
/// with a ₹ amount in the IPO form; shown on the public detail page).
model AnchorMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String? // Mutual Fund | FPI | Insurance | AIF | Other
  notes     String?
  sortOrder Int      @default(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Broad sector — Finance, Pharma, IT, Bank. The operator's list, editable.
/// Deliberately NOT the same thing as `extra.industry`, which holds the
/// exchanges' fine-grained Basic Industry (146 values: "Ferro & Silica
/// Manganese", "Plywood Boards/ Laminates"). Many industries roll up into one
/// sector, and the roll-up is what makes the sector derivable for the 850
/// records that already carry an industry.
model SectorMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Basic-Industry values that roll up here, so the mapping is data the
  /// operator can correct rather than a table buried in code.
  industries String[] @default([])
  sortOrder Int      @default(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Allowed UPI handles (the part after '@' in a UPI ID, e.g. "okaxis", "ybl").
/// Profile UPI IDs are accepted only when their handle is an active row here.
model UpiHandleMaster {
  id        String   @id @default(uuid())
  name      String   @unique
  sortOrder Int      @default(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model IpoCategoryMaster {
  id         String            @id @default(uuid())
  name       String            @unique // e.g. "Main Board IPO", "SME IPO"
  baseType   String            @default("mainboard") // engine mapping: 'mainboard' | 'sme'
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  issueTypes IssueTypeMaster[]
}

model IssueTypeMaster {
  id         String             @id @default(uuid())
  name       String             @unique // e.g. "IPO", "FPO", "Rights Issue", "OFS"
  categoryId String?
  category   IpoCategoryMaster? @relation(fields: [categoryId], references: [id])
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model LeadManager {
  id            String   @id @default(uuid())
  name          String
  /// Optional: a lead manager is not always published with a short code, and
  /// blocking the row on one meant real syndicate members could not be loaded.
  /// Postgres allows many NULLs under a UNIQUE index, so codeless rows coexist.
  /// Registrar keeps its code required — that one is always available.
  shortCode     String?  @unique
  contactPerson String?
  mobile        String?
  email         String?
  phone         String?
  gstin         String?
  address1      String?
  address2      String?
  city          String?
  state         String?
  pincode       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Registrar {
  id            String   @id @default(uuid())
  name          String
  shortCode     String   @unique
  contactPerson String?
  mobile        String?
  email         String?
  phone         String?
  gstin         String?
  address1      String?
  address2      String?
  city          String?
  state         String?
  pincode       String?
  allotmentUrl  String? // IPO allotment-status check URL
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MessageType {
  id          String   @id @default(uuid())
  channel     String // 'sms' | 'email' | 'whatsapp'
  key         String // 'otp' | 'allotment' | …
  label       String
  description String?
  vars        String[] @default([]) // variable names the caller supplies ({{var}})
  system      Boolean  @default(false) // built-in — protected from delete / key change
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channel, key])
}

model MessageTemplate {
  id            String   @id @default(uuid())
  tenantId      String   @default("t-platform") // platform default; white-label tenants override
  channel       String // 'sms' | 'email' | 'whatsapp'
  key           String // 'otp' | 'whatsapp_verify' | 'empanelment' | …
  locale        String   @default("en")
  enabled       Boolean  @default(true)
  dltTemplateId String? // SMS: DLT-registered template id (text lives in DLT)
  senderId      String? // SMS: sender/header override
  body          String? // SMS text ({{var}} placeholders) — dev preview / non-DLT providers
  subject       String? // Email subject
  bodyHtml      String? // Email HTML body ({{var}} placeholders)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, channel, key, locale])
  @@index([tenantId])
}

model FeatureDefinition {
  key          String           @id
  label        String
  description  String?
  valueType    FeatureValueType
  defaultValue Json
  isPublic     Boolean          @default(false) // exposed to the client/branding API
  createdAt    DateTime         @default(now())
  settings     TenantSetting[]
}

/// A tenant's override for one feature. `locked` freezes the value for the whole
/// subtree below this tenant (descendants inherit it and cannot override).
/// NOT tenant-scoped by RLS: the resolver walks ANCESTOR tenants' settings.
model TenantSetting {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  featureKey String
  feature    FeatureDefinition @relation(fields: [featureKey], references: [key])
  value      Json
  locked     Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([tenantId, featureKey])
  @@index([tenantId])
}

model Role {
  id          String       @id @default(uuid())
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  name        String
  permissions String[]
  scope       RoleScope    @default(own)
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  memberships Membership[]

  @@unique([tenantId, name])
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  isPrimary Boolean  @default(true)
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model User {
  id               String     @id @default(uuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  mobile           String?    @unique // customers: OTP login. Operators may have none.
  username         String?    @unique // operators (superadmin/partner/branch): password login
  passwordHash     String? // scrypt hash for operator accounts
  email            String?
  name             String?
  status           UserStatus @default(active)
  marketingConsent Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  profiles       InvestorProfile[]
  consents       Consent[]
  applications   Application[]
  watchlist      WatchlistItem[]
  devices        DeviceToken[]
  memberships    Membership[]
  gmpContributor GmpContributor?

  @@index([tenantId])
}

model InvestorProfile {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  relationship String     @default("self") // validated against RelationshipMaster (lowercase)
  fullName     String
  panTokenRef  String // PII (vault, reversible — used at rail-call time)
  panHash      String // deterministic HMAC of the PAN — uniqueness + dup detection
  dateOfBirth  DateTime?
  depository   Depository
  dpId         String
  clientId     String
  bankTokenRef String? // PII (vault) — bank A/C number
  ifsc         String?
  upiTokenRef  String? // PII (vault)
  // optional contact/bank fields used to prefill the ASBA form (not vaulted — low sensitivity)
  bankName     String?
  branchName   String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  email        String?
  mobile       String? // applicant's own contact (falls back to the account mobile on ASBA print)
  active       Boolean    @default(true) // false = deactivated (has applications, so never hard-deleted)
  kycStatus    KycStatus  @default(unverified)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  applications Application[]

  @@unique([tenantId, panHash]) // a PAN is registered once per tenant (self-PAN rule)
  @@index([userId])
  @@index([tenantId])
}

model Consent {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  type          ConsentType
  noticeVersion String
  grantedAt     DateTime      @default(now())
  withdrawnAt   DateTime?
  channel       String?
  applications  Application[]

  @@index([userId, type])
  @@index([tenantId])
}

model Ipo {
  id                   String            @id @default(uuid())
  symbol               String            @unique
  name                 String
  logoUrl              String?
  type                 IpoType
  /// Defaults to `ipo` so every existing row is correct without a backfill;
  /// only the four Further Public Offers need changing.
  instrument           Instrument        @default(ipo)
  exchanges            String[]
  status               IpoStatus         @default(upcoming)
  openDate             DateTime?
  closeDate            DateTime?
  allotmentDate        DateTime?
  listingDate          DateTime?
  listingGainPct       Decimal?
  priceBandMin         Decimal?
  priceBandMax         Decimal?
  lotSize              Int?
  minAmount            Decimal?
  issueSize            Decimal?
  isin                 String?
  registrar            String?
  objectsOfIssue       String?
  smeFlags             Json?
  reservations         String[]          @default([]) // reserved quotas offered: e.g. ["shareholder","employee"]
  /// bulk-imported historical rows start hidden — they sit in the catalog for review
  /// and are excluded from every public read until an operator publishes them.
  /// A real column, not a JSON flag: `NOT (extra->'k' = true)` is NULL-not-TRUE for
  /// rows without the key, which silently hides the whole catalog.
  hidden               Boolean           @default(false)
  autoPollSubscription Boolean           @default(true) // admin per-IPO switch for the live NSE subscription poller
  subscriptionAsOf     DateTime? // last time the poller refreshed this IPO's subscription
  extra                Json? // operator-entered extended fields: issue type, shares-size, reservation table, application series, company info (HTML), FAQs, partners, lead managers…
  categories           IpoCategory[]
  subscriptions        IpoSubscription[]
  gmps                 IpoGmp[]
  documents            IpoDocument[]
  applications         Application[]
  allotmentRecords     AllotmentRecord[]
  allotmentImports     AllotmentImport[]
  allotmentArchive     AllotmentArchive?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model IpoCategory {
  id    String  @id @default(uuid())
  ipoId String
  ipo   Ipo     @relation(fields: [ipoId], references: [id])
  code  String
  label String?

  @@unique([ipoId, code])
}

model IpoSubscription {
  id                     String   @id @default(uuid())
  ipoId                  String
  ipo                    Ipo      @relation(fields: [ipoId], references: [id])
  category               String
  timesSubscribed        Decimal // subscription by SHARES (demand qty ÷ offered)
  bidCount               Int? // number of applications/bids in this category (from catwise)
  applicationsSubscribed Decimal? // subscription by APPLICATIONS (bidCount ÷ max allottees); drives retail allotment odds
  asOf                   DateTime @default(now())

  @@index([ipoId, asOf])
}

model IpoGmp {
  id              String   @id @default(uuid())
  ipoId           String
  ipo             Ipo      @relation(fields: [ipoId], references: [id])
  value           Decimal
  trend           String?
  source          String?
  /// who entered it — GMP is unofficial, so every value stays traceable to a person
  submittedBy     String?
  submittedByName String?
  asOf            DateTime @default(now())

  @@index([ipoId, asOf])
  @@index([submittedBy])
}

/// Allow-list of non-operator users permitted to submit GMP. Operators reach the
/// same screen through the `gmp.submit` permission instead; this covers people
/// who should enter GMP without any admin access at all.
model GmpContributor {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  active    Boolean  @default(true)
  note      String?
  addedBy   String?
  createdAt DateTime @default(now())
}

model IpoDocument {
  id      String  @id @default(uuid())
  ipoId   String
  ipo     Ipo     @relation(fields: [ipoId], references: [id])
  type    String // RHP / DRHP / prospectus
  url     String
  summary String?
}

model MemberCredential {
  id              String        @id @default(uuid())
  tenantId        String?
  tenant          Tenant?       @relation(fields: [tenantId], references: [id])
  exchange        Exchange
  memberName      String
  memberType      String // broker / merchant_banker / syndicate
  loginId         String
  memberCode      String
  passwordRef     String // vault ref
  ibbsIdRef       String? // vault ref (BSE)
  checksumKeyRef  String? // vault ref (BSE) — AES-256 key for the request Checksum header
  subBrokerCode   String?
  baseUrl         String
  env             String // live / uat
  active          Boolean       @default(true)
  subscriptionUse Boolean       @default(false) // OUR OWN membership — background jobs (subscription poll, ipomaster, holidays) always use this one
  applications    Application[]

  @@index([tenantId])
}

model Application {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  investorProfileId  String
  profile            InvestorProfile   @relation(fields: [investorProfileId], references: [id])
  ipoId              String
  ipo                Ipo               @relation(fields: [ipoId], references: [id])
  memberCredentialId String?
  memberCredential   MemberCredential? @relation(fields: [memberCredentialId], references: [id])
  consentId          String? // DPDP: the data-sharing consent this bid was submitted under
  consent            Consent?          @relation(fields: [consentId], references: [id])

  category           String // investor bucket (retail / sNII / bNII / qib)
  applicantType      ApplicantCategory @default(individual)
  batchId            String? // set when created via family/bulk apply — groups the batch
  lots               Int
  /// exact share quantity as submitted (partner API sends FINAL figures); null → lots × lotSize
  shareQty           Int?
  /// print grouping label on the ASBA form (partner-supplied, or the account holder)
  familyGroup        String?
  atCutoff           Boolean           @default(true)
  bidPrice           Decimal?
  amount             Decimal
  applyMethod        ApplyMethod
  rail               Exchange?
  applicationNumber  String?
  asbaFormNo         String? // ASBA print-form number, allocated from the IPO's active "PDF Printing" series
  bidReferenceNumber String?
  upiFlag            String?
  asbaBlockRef       String?
  remark             String? // our bid UID, echoed to rail
  amountBlocked      Decimal?
  allottedLots       Int? // lots actually allotted (0 = not allotted)
  allottedAmount     Decimal? // amount debited for the allotted shares
  refundAmount       Decimal? // blocked amount released back
  allottedAt         DateTime?
  allotmentReason    String? // registrar's rejection reason (from the imported allotment file)
  status             ApplicationStatus @default(draft)
  idempotencyKey     String            @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  events ApplicationStatusEvent[]

  @@index([userId])
  @@index([ipoId])
  @@index([tenantId])
  @@index([rail, applicationNumber])
}

/// User notifications (allotment / listing / status). Persisted so the app has an
/// in-app inbox and so a push send is auditable. Denormalized (userId, no FK).
model Notification {
  id        String    @id @default(uuid())
  tenantId  String?
  userId    String
  type      String // allotment | listing | status
  title     String
  body      String
  data      Json? // { applicationId, ipoSymbol, status, ... }
  channel   String    @default("push")
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Denormalized audit trail of operator mutations (create/update/delete across the
/// admin, catalog, settings and allotment endpoints). A historical snapshot — no FKs.
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorMobile String?
  action      String // e.g. role.create, member.add, ipo.update, setting.set, allotment.record
  targetType  String?
  targetId    String?
  targetLabel String?
  tenantSlug  String?
  detail      Json?
  at          DateTime @default(now())

  @@index([at])
}

model ApplicationStatusEvent {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id])
  status        ApplicationStatus
  detail        Json?
  at            DateTime          @default(now())

  @@index([applicationId])
}

model WatchlistItem {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipoId     String
  createdAt DateTime @default(now())

  @@unique([userId, ipoId])
  @@index([tenantId])
}

model DeviceToken {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  platform String
  token    String
  active   Boolean @default(true)

  @@unique([token])
  @@index([tenantId])
}

/// ── Registrar allotment data (Admin → Allotment → Import) ───────────────────
/// Full registrar allottee-file rows (DBF / XLSB / XLSX / CSV), one set per IPO.
/// Internal back-office data: raw PAN is kept by operator decision (the allotment
/// list is an admin-only tool and partial-PAN search needs it). Size is bounded by
/// archive-then-purge: rows are exported to a gz NDJSON archive on disk and deleted
/// from the DB ~60 days after listing (or on demand), summaries stay forever.
model AllotmentRecord {
  id             Int     @id @default(autoincrement())
  ipoId          String
  ipo            Ipo     @relation(fields: [ipoId], references: [id])
  applicationNo  String
  pan            String  @default("")
  dpClientId     String? // DP id + client id (16 chars)
  category       String? // registrar bucket (IND / RET / SHA / EMP ...)
  name           String?
  appliedShares  Int     @default(0)
  amount         Int     @default(0) // whole rupees applied / blocked
  allottedShares Int     @default(0)
  allottedAmount Int     @default(0) // whole rupees adjusted for allotment
  refundAmount   Int     @default(0) // whole rupees released
  reason         String? // registrar rejection reason (non-allottees)

  @@unique([ipoId, applicationNo])
  @@index([ipoId, pan])
  @@index([ipoId, amount])
}

/// One uploaded registrar file (registrars split big IPOs into FILE1..FILEn, so
/// several imports per IPO are normal). The summary row survives archive/purge.
model AllotmentImport {
  id         String    @id @default(uuid())
  ipoId      String
  ipo        Ipo       @relation(fields: [ipoId], references: [id])
  fileName   String
  fileSize   Int
  format     String // dbf | xlsb | xlsx | xls | csv
  status     String    @default("processing") // processing | done | failed
  stage      String? // parsing | importing | matching (progress hint while processing)
  totalRows  Int       @default(0)
  imported   Int       @default(0) // rows written (duplicates across FILEn skipped)
  allotted   Int       @default(0) // rows with allotted shares > 0
  matched    Int       @default(0) // OUR applications auto-updated from this file
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([ipoId, createdAt])
}

/// Archived (purged-from-DB) allotment data — gz NDJSON on the API disk, restorable
/// into AllotmentRecord with one click.
model AllotmentArchive {
  id        String   @id @default(uuid())
  ipoId     String   @unique
  ipo       Ipo      @relation(fields: [ipoId], references: [id])
  fileName  String // file under uploads/allotment-archive
  rows      Int
  fileSize  Int
  createdAt DateTime @default(now())
}

/// Partner self-onboarding. Submissions live HERE, not in Tenant: a half-real
/// tenant would leak into the tenant tree, the settings cascade, RLS scoping and
/// every report. On approval the operator runs the normal registerTenant() path,
/// which assigns the channel code and creates the admin user.
model PartnerApplication {
  id          String  @id @default(uuid())
  /// the OTP-verified account that submitted it (lets them resume + track status)
  userId      String?
  mobile      String
  email       String
  contactName String
  /// what the applicant is asking to become; the operator decides the real type
  kind        String  @default("partner") // partner | whitelabel | branch

  entityType  String? // individual | proprietorship | partnership | llp | pvt_ltd
  legalName   String
  panTokenRef String? // PII (vault) — business PAN, resolved only on the review screen
  panMasked   String?
  gstin       String?
  city        String?
  state       String?
  sebiRegNo   String?
  arn         String?
  notes       String?
  /// [{ type, url, name }] — uploaded via the applicant-scoped endpoint
  documents   Json?

  status     String    @default("submitted") // submitted | changes_requested | approved | rejected
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  tenantId   String? // set once approved

  /// single-use activation link emailed on approval (operator can copy it if SMTP is off)
  inviteToken   String?   @unique
  inviteExpires DateTime?
  activatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([mobile])
}

/// Every transactional message the system sends, on ANY route — OTP, partner
/// approval, allotment alerts, WhatsApp replies, and operator test sends.
///
/// Written by the LEAF adapters (SmsService / EmailService / WhatsappService),
/// not by their callers: a new feature that sends a message is logged without
/// anyone remembering to add logging. Recording never throws — a logging fault
/// must not lose a real send.
///
/// The recipient is stored MASKED (98XXXX1234 / j***@example.com) with the last
/// four digits kept separately so support can find a delivery without the log
/// becoming a table of contact details.
model MessageLog {
  id                String   @id @default(uuid())
  tenantId          String?
  channel           String // sms | email | whatsapp
  templateKey       String? // otp | empanelment | … (null for ad-hoc sends)
  recipient         String // masked
  recipientLast4    String? // search key
  subject           String? // email only
  preview           String? // rendered body, truncated
  status            String // sent | failed | dev
  provider          String? // rmlconnect | custom | msg91 | smtp | meta
  providerMessageId String?
  error             String?
  /// operator "Send test" from Message Templates rather than a real event
  isTest            Boolean  @default(false)
  meta              Json?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([channel, status, createdAt])
  @@index([recipientLast4])
  @@index([tenantId, createdAt])
}
