<?xml version="1.0" encoding="UTF-8"?>
<!--
  ACME HTTP-01 VALIDATION PATH.

  Let's Encrypt fetches http://<host>/.well-known/acme-challenge/<token> — an
  EXTENSIONLESS file — and IIS refuses to serve those. Measured here as a
  404.17, "the requested content appears to be script", which reads like a
  missing file and is really a missing handler and MIME map.

  WHY A FILE IN THIS FOLDER RATHER THAN A <location> BLOCK IN THE SITE'S
  web.config: ASP.NET's parser rejects a location path beginning with a dot
  ("<location> path attribute must be a relative virtual path. It cannot start
  with any of ' ' '.' '/' or '\'"), and `.well-known` does. Attempting it takes
  the WHOLE SITE to a 500 configuration error, not just that path.

  WHY IT IS COMMITTED UNDER public/ RATHER THAN LEFT TO WIN-ACME: win-acme
  writes an equivalent file at validation time, inside `out/` — which
  `npm run build` deletes wholesale. A renewal landing during a build loses it.
  Here it is copied into out/ by every build, so it is always present, and it
  works for every partner domain we add without anyone remembering this.

  Scoped to this folder alone, so nothing else on the site can serve an
  extensionless file as text/plain.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clear />
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>
    <handlers>
      <clear />
      <add name="AcmeStaticFile" path="*" verb="GET" modules="StaticFileModule"
           resourceType="Either" requireAccess="Read" />
    </handlers>
  </system.webServer>
</configuration>
