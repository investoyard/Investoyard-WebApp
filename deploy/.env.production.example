# Investoyard production secrets — copy to the repo root as `.env.deploy`, fill in,
# and NEVER commit the filled copy.
#   cp deploy/.env.production.example .env.deploy

# --- Database ---------------------------------------------------------------
# Superuser password (migrations/seed; also guards the db container).
POSTGRES_PASSWORD=change-me-strong-password
# Password for the runtime RLS role `investoyard_app` (set in DEPLOY.md step 3).
APP_DB_PASSWORD=change-me-different-strong-password

# --- App secrets ------------------------------------------------------------
# JWT signing secret (long random string).
JWT_SECRET=change-me-long-random-string
# PII vault master key (dev/local provider). With KMS_KEY_ID set, KMS wraps new
# secrets and this key only decrypts older local-wrapped tokens.
PII_VAULT_KEY=change-me-32-bytes-or-longer-key

# --- Exchange rail ----------------------------------------------------------
# NSE e-IPO base URL (UAT until the merchant banker issues live credentials).
NSE_BASE_URL=https://uat.example/eipo
# Require signed exchange callbacks (Authorization = base64(SHA256(SHA1(password)))).
RAIL_CALLBACK_AUTH=enabled

# --- Optional providers (enable to go live) ----------------------------------
# Real SMS delivery (e.g. msg91 / twilio). Unset = dev mode (OTP logged, 123456 accepted).
SMS_PROVIDER=
# AWS KMS key for the PII vault. Needs `@aws-sdk/client-kms` in the image + an
# IAM role/credentials on the host. Unset = local AES provider.
KMS_KEY_ID=
